# Copy to backend/.env if you want a live language model.
# The app runs fully without these values using the built-in rules engine.

# Optional OpenAI-compatible chat API. Leave blank for the demo fallback.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Local file. On Render, leave this unset and use the Postgres connection string
# Render injects as DATABASE_URL (postgres://... is accepted).
DATABASE_URL=sqlite:///./customer360.db
